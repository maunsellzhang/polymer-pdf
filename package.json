{
  "name": "polymer-pdf",
  "version": "1.0.0",
  "description": "本地预览、排序并合并 PDF 与图片，支持网页版和 Windows 桌面版。",
  "author": "Maunsell",
  "license": "ISC",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "npm run dev",
    "predev": "node scripts/copy-pdf-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdf-assets.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test tests/*.test.js",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win --x64 --dir",
    "desktop:build": "npm run build && electron-builder --win portable --x64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node scripts/smoke-browser.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "com.maunsell.polymerpdf",
    "productName": "聚合 PDF",
    "executableName": "PolymerPDF",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/favicon.ico"
    },
    "artifactName": "Polymer-PDF-${version}-windows-${arch}.${ext}"
  }
}
